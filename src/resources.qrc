<RCC>
    <qresource prefix="/images">
        <file alias="AppIcon">images/mcenter.png</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="Rajdhani-Medium.ttf">../resources/fonts/Rajdhani-Medium.ttf</file>
        <file alias="Rajdhani-SemiBold.ttf">../resources/fonts/Rajdhani-SemiBold.ttf</file>
        <file alias="Rajdhani-Bold.ttf">../resources/fonts/Rajdhani-Bold.ttf</file>
        <file alias="IBMPlexMono-Regular.ttf">../resources/fonts/IBMPlexMono-Regular.ttf</file>
        <file alias="IBMPlexMono-Medium.ttf">../resources/fonts/IBMPlexMono-Medium.ttf</file>
    </qresource>
    <qresource prefix="/translations">
        <file alias="lang_de_DE">i18n/Mcenter_de_DE.qm</file>
        <file alias="lang_en">i18n/Mcenter_en.qm</file>
        <file alias="lang_es">i18n/Mcenter_es.qm</file>
        <file alias="lang_eu">i18n/Mcenter_eu.qm</file>
        <file alias="lang_fr">i18n/Mcenter_fr.qm</file>
        <file alias="lang_hu">i18n/Mcenter_hu.qm</file>
        <file alias="lang_it">i18n/Mcenter_it.qm</file>
        <file alias="lang_nb">i18n/Mcenter_nb.qm</file>
        <file alias="lang_nl_NL">i18n/Mcenter_nl_NL.qm</file>
        <file alias="lang_pt_br">i18n/Mcenter_pt_BR.qm</file>
        <file alias="lang_pt_pt">i18n/Mcenter_pt_PT.qm</file>
        <file alias="lang_ru">i18n/Mcenter_ru.qm</file>
        <file alias="lang_tr">i18n/Mcenter_tr.qm</file>
        <file alias="lang_vi">i18n/Mcenter_vi.qm</file>
        <file alias="lang_zh_cn">i18n/Mcenter_zh_CN.qm</file>
    </qresource>
</RCC>
