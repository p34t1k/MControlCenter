# Arch/pacman install hooks. Everything is best effort: a package install must never fail because of a hardware detail.
post_install() {
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=hidraw >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=i2c-dev >/dev/null 2>&1 || true
    modprobe i2c-dev >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl reload dbus >/dev/null 2>&1 || true
    systemctl enable mcenter-doctor.service mcenter-battery.service >/dev/null 2>&1 || true
    # MSI WMI driver for automatic battery calibration: only where the kernel does not ship it and this is an MSI laptop
    if grep -qiE 'micro-star|msi' /sys/class/dmi/id/sys_vendor 2>/dev/null && ! modinfo msi-wmi-platform >/dev/null 2>&1 && command -v dkms >/dev/null 2>&1; then
        dkms add msi-wmi-platform/1.0 >/dev/null 2>&1 || true
        dkms install msi-wmi-platform/1.0 >/dev/null 2>&1 || echo "mcenter: msi-wmi-platform did not build (needs kernel headers); battery calibration will use the guided manual version" >&2
    fi
    # msi-ec driver: the boot service builds/loads it (needs headers; it retries after every kernel update)
    if grep -qiE 'micro-star|msi' /sys/class/dmi/id/sys_vendor 2>/dev/null; then systemctl start --no-block mcenter-doctor.service >/dev/null 2>&1 || true; fi
    echo "mcenter: start it from the application menu (it lives in the system tray)."
    echo "mcenter: the msi-ec driver comes from your kernel or from the msi-ec-dkms AUR package; check with: /usr/libexec/mcenter/mcenter-doctor status"
}
post_upgrade() { post_install; }
pre_remove() {
    # never leave a calibration half done
    [ -x /usr/libexec/mcenter/mcenter-battery ] && /usr/libexec/mcenter/mcenter-battery restore >/dev/null 2>&1 || true
    systemctl disable mcenter-doctor.service mcenter-battery.service >/dev/null 2>&1 || true
}
post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    udevadm control --reload-rules >/dev/null 2>&1 || true
    command -v dkms >/dev/null 2>&1 && dkms remove msi-wmi-platform/1.0 --all >/dev/null 2>&1 || true   # the msi-ec driver is left alone on purpose
}
