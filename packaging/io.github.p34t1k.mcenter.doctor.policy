<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Mcenter</vendor>
  <action id="io.github.p34t1k.mcenter.doctor">
    <description>Repair the MSI laptop driver (msi-ec)</description>
    <message>Authentication is required to build and load the MSI laptop driver</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/mcenter/mcenter-doctor</annotate>
  </action>
</policyconfig>
